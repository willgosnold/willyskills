=== entry 611c49c8edff
kind: translation
rules: transcripts
intent: LAST_CHAT finds the newest agent chat that ran in each worktree, so a worktree in recent use is never bucketed safe. In T3 the chats are Claude Code's per-directory transcripts and Codex's rollout files, not Cursor's agent-transcripts. stat and date are called so they work on Linux and macOS.
--- upstream
# Transcripts dir: ~/.cursor/projects/<slugified-repo-path>/agent-transcripts.
slug=$(printf '%s' "$main_wt" | sed 's#^/##; s#/#-#g')
transcripts="$HOME/.cursor/projects/$slug/agent-transcripts"
now=$(date +%s)
--- patched
# Chat transcripts. Claude Code keeps one folder per working directory under
# ~/.claude/projects, named after the path with every other character as "-".
# Codex records each session's cwd in its rollout files. T3 sets CODEX_HOME for
# its own Codex, so look in every ~/.codex* home as well.
mtime() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null; }
day() { date -d "@$1" '+%Y-%m-%d' 2>/dev/null || date -r "$1" '+%Y-%m-%d' 2>/dev/null; }
claude_projects="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects"
codex_rollouts=$(mktemp)
for home in "${CODEX_HOME:-}" "$HOME"/.codex "$HOME"/.codex-*; do
	[ -n "$home" ] && [ -d "$home/sessions" ] && (cd "$home/sessions" && pwd -P)
done | sort -u | while read -r sessions; do
	find "$sessions" -name 'rollout-*.jsonl' -mtime -30 2>/dev/null
done > "$codex_rollouts"
now=$(date +%s)

=== entry 2e4f96e68d4e
kind: translation
rules: transcripts
intent: Same as the setup block: look up the worktree's Claude Code transcript folder and any Codex rollout whose cwd is the worktree or a path inside it. Keeps upstream's 4-day recent window and its guard against prefix matches (glint-482 vs glint-482-r37).
--- upstream
	# Most recent chat whose transcript operated in this worktree. Match path
	# followed by "/" or a quote so glint-482 does not match glint-482-r37.
	last="-"; last_ts=0
	if [ -d "$transcripts" ]; then
		f=$(rg -l -e "${wt}/" -e "${wt}\"" "$transcripts" 2>/dev/null \
			| xargs stat -f '%m %N' 2>/dev/null | sort -rn | head -1)
		if [ -n "$f" ]; then last_ts=$(echo "$f" | awk '{print $1}')
			last=$(date -r "$last_ts" '+%Y-%m-%d' 2>/dev/null); fi
	fi
	recent=$([ "$last_ts" -gt 0 ] 2>/dev/null && [ $(( (now - last_ts) / 86400 )) -le 4 ] && echo yes || echo no)
--- patched
	# Most recent agent chat that ran in this worktree or below it.
	last="-"; last_ts=0
	slug=$(printf '%s' "$wt" | sed 's#[^A-Za-z0-9]#-#g')
	for f in "$claude_projects/$slug"/*.jsonl \
		$([ -s "$codex_rollouts" ] && xargs grep -l -F -e "\"cwd\":\"${wt}\"" -e "\"cwd\":\"${wt}/" < "$codex_rollouts" 2>/dev/null); do
		[ -f "$f" ] || continue
		ts=$(mtime "$f")
		[ "${ts:-0}" -gt "$last_ts" ] && last_ts=$ts
	done
	[ "$last_ts" -gt 0 ] && last=$(day "$last_ts")
	recent=$([ "$last_ts" -gt 0 ] 2>/dev/null && [ $(( (now - last_ts) / 86400 )) -le 4 ] && echo yes || echo no)

=== entry 311b634de8bf
kind: translation
rules: transcripts
intent: Also removes the temporary list of Codex rollouts.
--- upstream
rm -f "$prs"
--- patched
rm -f "$prs" "$codex_rollouts"
